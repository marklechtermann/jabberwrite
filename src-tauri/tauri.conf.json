{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Jabberwrite",
  "identifier": "io.github.marklechtermann.jabberwrite",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "settings",
        "title": "Jabberwrite Settings",
        "url": "settings.html",
        "width": 760,
        "height": 560,
        "minWidth": 560,
        "minHeight": 400,
        "resizable": true,
        "visible": false,
        "skipTaskbar": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg", "app", "appimage", "deb"],
    "category": "Productivity",
    "shortDescription": "Voice-to-text dictation for agentic coding",
    "license": "Apache-2.0",
    "copyright": "Copyright 2026 Mark Lechtermann",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVFMjk5REE0QTM2MDlGQzkKUldUSm4yQ2pwSjBwWGloOEdNMitXSWJDS0tSeDVLSXQxZ2xOTDg4dG9sbnNFMFc1YjVaeEU4L0kK",
      "endpoints": ["https://github.com/marklechtermann/jabberwrite/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
